# Database Configuration (Defaults to PostgreSQL or automatically falls back to local SQLite)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airquality_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airquality_db

# ==============================================================================
# OpenAI API Key (OPTIONAL)
# ==============================================================================
# 1. To use OpenAI: paste your API key below (starts with "sk-proj-..." or "sk-..."):
#    OPENAI_API_KEY=sk-proj-your_key_here
#    Get a key from: https://platform.openai.com/api-keys
#
# 2. If you LEAVE THIS EMPTY, NO PROBLEM! 
#    VayuNet has a built-in, CPCB-certified Automated Expert Advisory Engine 
#    that generates high-quality, contextual school and worker advisories 
#    100% FREE and OFFLINE, so the hackathon demo NEVER breaks!
# ==============================================================================
OPENAI_API_KEY=

# Server & Network Configuration
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=*
VITE_API_URL=http://localhost:8000/api

# Real-Time Telemetry Feed: Uses live Open-Meteo API (Delhi NCR) + 25 Low-Cost Optical Micro-Sensors

